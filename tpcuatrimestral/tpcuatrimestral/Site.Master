<asp:HyperLink runat="server" CssClass="dropdown-item dropdown-toggle" NavigateUrl="~/Vistas/ListaDueño.aspx">Veterinario</asp:HyperLink>
<ul class="dropdown-menu">
  <li>
      <asp:HyperLink runat="server" CssClass="dropdown-item" NavigateUrl="~/Vistas/ListaDueño.aspx">Listar Dueño</asp:HyperLink>
  </li>
  <li>
      <asp:HyperLink runat="server" CssClass="dropdown-item" NavigateUrl="~/Vistas/AgregarDueño.aspx">Cargar Dueño</asp:HyperLink>
  </li>
